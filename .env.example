# Riot-API-Key von https://developer.riotgames.com (Development-Keys laufen nach 24h ab)
LOL_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Regionales Routing für account-v1/match-v5 (EUW -> europe)
RIOT_REGION=europe
# PostgreSQL (docker compose setzt die URL für den App-Container selbst)
DATABASE_URL=postgresql+psycopg://primestats:primestats@localhost:5432/primestats
# 1 = Beispieldaten statt Riot-API verwenden
PRIMESTATS_DEMO=0
# Token für den Scrim-Uploader (leer = Uploads deaktiviert), z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(24))"
UPLOAD_TOKEN=
